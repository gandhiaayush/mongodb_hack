{
  "name": "snoopy-voice-receptionist",
  "version": "0.1.0",
  "description": "Voice receptionist (Twilio + Gemini Live + MongoDB Atlas) with a recursive self-improvement loop",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "live": "tsx scripts/live.ts",
    "doctor": "tsx scripts/doctor.ts",
    "seed": "tsx scripts/seed-demo.ts",
    "setup": "npm install && npm --prefix teacher install",
    "build": "tsc",
    "start": "node dist/server.js",
    "check": "tsc --noEmit"
  },
  "engines": { "node": ">=22.0.0" },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "alawmulaw": "^6.0.0",
    "body-parser": "^1.20.3",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "mongodb": "^6.10.0",
    "twilio": "^5.5.1",
    "ws": "^8.20.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3"
  }
}
