# Required
GEMINI_API_KEY=

# Twilio. With ACCOUNT_SID + AUTH_TOKEN + PHONE_NUMBER, `npm run live` points the number's webhook at ngrok for you.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=   # E.g. +14155550123
# Public hostname of this server, no scheme (e.g. my-app.onrender.com or abc.ngrok.app)
PUBLIC_HOST=
PORT=3000

# MongoDB Atlas (optional; falls back to an in-memory seeded store)
MONGODB_URI=
MONGODB_DB=snoopy

# Dashboard API (optional)
# If set, /api requires header x-dashboard-token (except /api/health and OPTIONS)
DASHBOARD_TOKEN=
# Comma-separated allowed CORS origins; empty means *
ALLOWED_ORIGINS=

# Optional: copy pickup/delivery bookings to Google Calendar (share the calendar with the service account email)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
